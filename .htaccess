<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------
    # Security: Block direct access to sensitive files
    # -------------------------------------------------------
    RewriteRule ^\.env$ - [F,L,NC]
    RewriteRule ^\.env\..* - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^artisan$ - [F,L,NC]
    RewriteRule ^(storage|bootstrap/cache)/ - [F,L,NC]
    RewriteRule ^(app|config|database|resources|routes|tests|vendor)/ - [F,L,NC]

    # -------------------------------------------------------
    # Redirect: Route everything through public/
    # -------------------------------------------------------

    # If the request is already targeting public/, serve it directly (avoid loop)
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Pass the real path to Apache so it can find files inside public/
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Pass directories inside public/ (e.g. /storage symlink)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Everything else → public/index.php (Laravel front controller)
    RewriteRule ^(.*)$ public/index.php [L,QSA]

</IfModule>
