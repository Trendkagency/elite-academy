<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------
    # Security: Block direct access to sensitive internal files & storage internals
    # (Allow public disk URLs under /storage/* to resolve via public/storage or Laravel)
    # -------------------------------------------------------
    RewriteRule ^\.env$ - [F,L,NC]
    RewriteRule ^\.env\..* - [F,L,NC]
    RewriteRule ^composer\.(json|lock)$ - [F,L,NC]
    RewriteRule ^package(-lock)?\.json$ - [F,L,NC]
    RewriteRule ^artisan$ - [F,L,NC]
    RewriteRule ^storage/?$ - [F,L,NC]
    RewriteRule ^storage/(app|framework|logs|debugbar|clockwork)/ - [F,L,NC]
    RewriteRule ^bootstrap/cache/ - [F,L,NC]
    RewriteRule ^(app|config|database|resources|routes|tests|vendor)/ - [F,L,NC]

    # -------------------------------------------------------
    # Redirect: Route everything through public/
    # -------------------------------------------------------

    # If the request is already targeting public/, serve it directly (avoid loop)
    RewriteCond %{REQUEST_URI} ^/public/ [NC]
    RewriteRule ^ - [L]

    # Pass real files inside public/ (e.g. /storage/avatars/..., /css/..., /js/...)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Pass non-storage directories inside public/
    RewriteCond %{REQUEST_URI} !^/storage(/|$) [NC]
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -d
    RewriteRule ^(.*)$ public/$1 [L,QSA]

    # Everything else → public/index.php (Laravel front controller)
    RewriteRule ^(.*)$ public/index.php [L,QSA]

</IfModule>
